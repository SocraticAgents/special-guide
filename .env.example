# Which provider powers all three agents (same API, different system prompts per Sec 3.5 of the proposal).
LLM_PROVIDER=openrouter          # anthropic | openai | openrouter

# OpenRouter (OpenAI-compatible API — https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_SITE_URL=https://localhost
OPENROUTER_SITE_NAME=Socratic-Agent

# Anthropic (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Sampling
LLM_TEMPERATURE=0.4

# Teacher dashboard passcode (pages/1_Teacher_Dashboard.py) — shared passcode, not real
# per-teacher accounts; proportionate for a pilot-scale prototype.
TEACHER_PASSCODE=teach123

# Optional: override where the SQLite record (students/sessions/turns/snapshots) is stored.
# SOCRATIC_AGENT_DB=./data/socratic_agent.db
