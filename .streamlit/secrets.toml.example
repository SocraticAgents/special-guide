# Template for Streamlit Community Cloud secrets.
# Paste these (with real values) into: App settings -> Secrets.
# Streamlit exposes top-level keys as environment variables, so os.getenv() picks them up.
# For local runs, keep using .env instead. Never commit a real secrets.toml.

LLM_PROVIDER = "openrouter"          # anthropic | openai | openrouter | gemini

OPENROUTER_API_KEY = "sk-or-..."
OPENROUTER_MODEL = "anthropic/claude-sonnet-4.5"
OPENROUTER_DATA_COLLECTION = "deny"

GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-2.5-flash"

TEACHER_PASSCODE = "change-me"
